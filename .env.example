# Espresso control plane configuration (Node.js / Vercel)
#
# Keep the real copy in packages/node-server/.env.example; this root file
# exists so `cp .env.example .env` keeps working before entering the package.
# Run the dev server from packages/node-server — it loads .env from there.

# Upstash Redis (serverless). Both unset → in-memory store (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# HMAC secret for session tokens — REQUIRED on serverless.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional management API key (X-Espresso-Key). Unset = trusted-network mode.
ESPRESSO_API_KEY=

# Node protocol tuning
NODE_ONLINE_TTL=90
RPC_TIMEOUT_MS=15000

# Log format: text | json
LOG_FORMAT=text
