{
  "name": "@espresso/node-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Espresso control plane — Node.js/TypeScript port of the Go control plane, deployable on Vercel",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/dev.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "vercel deploy --prebuilt --cwd packages/node-server"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
