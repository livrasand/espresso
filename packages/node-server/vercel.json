{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/main.ts": {
      "maxDuration": 60,
      "includeFiles": "bin/**"
    }
  },
  "rewrites": [
    {
      "source": "/login",
      "destination": "/auth"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/main"
    },
    {
      "source": "/node/:path*",
      "destination": "/api/main"
    },
    {
      "source": "/health",
      "destination": "/api/main"
    },
    {
      "source": "/metrics",
      "destination": "/api/main"
    },
    {
      "source": "/:owner/:repo.git/:path*",
      "destination": "/api/main"
    }
  ],
  "installCommand": "npm install",
  "buildCommand": "mkdir -p bin/git-core && (cp /usr/bin/git bin/git 2>/dev/null; cp /usr/libexec/git-core/* bin/git-core/ 2>/dev/null; chmod +x bin/git bin/git-core/* 2>/dev/null; true) && npm run build",
  "headers": [
    {
      "source": "/(.*)\\.(css|js|svg|png|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
