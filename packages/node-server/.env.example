# Espresso control plane configuration (Node.js / Vercel)

# ── Persistence (required) ─────────────────────────────────────────
# Upstash Redis. Serverless-safe; injected by the Vercel Marketplace
# integration or set manually. Locally, when both are unset the server
# falls back to an in-memory store (dev only, data is lost on restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Sessions / secrets ─────────────────────────────────────────────
# Long-lived secret used to HMAC-sign session tokens. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# With serverless, this MUST be set: instances rotate constantly and the
# key cannot live in memory like the Go version did.
SESSION_SECRET=

# Optional management API key for /api/nodes endpoints (X-Espresso-Key header).
# LEAVE EMPTY ONLY ON A TRUSTED/PRIVATE NETWORK — with it unset the node
# management API accepts the API key as account identity (open).
ESPRESSO_API_KEY=

# ── Node protocol tuning ───────────────────────────────────────────
# How long a node stays "online" without a poll (seconds).
NODE_ONLINE_TTL=90
# Max time a management API request waits for the node to poll its inbox
# and answer an RPC command (ms). Must be below the serverless timeout
# (30s here) minus margin.
RPC_TIMEOUT_MS=15000

# ── Misc ───────────────────────────────────────────────────────────
# Owned by the Vercel build; no-op in this port.
COMMIT_HASH=

# Local dev only (packages/node-server dev server; built-in default 8333)
PORT=8333
